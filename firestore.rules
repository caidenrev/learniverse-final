/**
 * @fileoverview Firestore Security Rules for Learniverse application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, ensuring that users can only
 * access their own data. All user-specific data is nested under the /users/{userId}
 * path.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Only the user themselves can
 *   read or write their profile data.
 * - /users/{userId}/subscriptions/{subscriptionId}: Stores subscription information
 *   for each user. Only the user themselves can manage their subscriptions.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own data.
 * - Data validation is relaxed to facilitate rapid prototyping and iteration,
 *   focusing primarily on authorization.
 * - Listing of users is disallowed for privacy and security reasons.
 *
 * Denormalization for Authorization:
 *  - The subscription document is nested under the user document, avoiding the need for complex queries to determine user access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (get, create, update, delete) - Authenticated user with matching {userId}.
     * @deny (get, create, update, delete) - Any other user or unauthenticated request.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Only signed-in users can access user documents
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing users is not permitted

      // Only the user themselves can create their profile
      allow create: if isSignedIn() && isOwner(userId);

      // Only the user themselves can update their profile and user must exist.
      allow update: if isSignedIn() && isOwner(userId) && resource != null;

      // Only the user themselves can delete their profile and user must exist.
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces user-ownership for subscription documents.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (get, create, update, delete) - Authenticated user with matching {userId}.
     * @deny (get, create, update, delete) - Any other user or unauthenticated request.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      // Only signed-in users can access their own subscription documents
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      // Only the user themselves can create their subscription
      allow create: if isSignedIn() && isOwner(userId);

      // Only the user themselves can update their subscription and user must exist.
      allow update: if isSignedIn() && isOwner(userId) && resource != null;

      // Only the user themselves can delete their subscription and user must exist.
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    // ---- Helper functions ----

    // Checks if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user is the owner of the resource based on the userId.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}